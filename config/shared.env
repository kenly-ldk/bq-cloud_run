# Single source of truth for both demos in this repo.
# Sourced by Bash (config/prelude.sh, scripts/fpe/*.sh),
# loaded by Python (config/_loader.py).
#
# Convention:
#   - Project-identity values below are PLACEHOLDERS — fill them in via
#     config/shared.env.local (gitignored), which is layered on top of this
#     file at load time. .local values win for any key they set.
#   - Reference-architecture conventions (service names, dataset names, image
#     paths, sweep defaults) are sane defaults that work as-is.
#
# Constraint: shell-safe scalars only. Anything secret-class (Protegrity
# credentials, the FPE key) lives in Secret Manager or in shared.env.local.

# === Fill these in via shared.env.local ===

# --- GCP project ---
PROJECT_ID=your-gcp-project-id
PROJECT_NUMBER=

# --- Credentials pinning (optional; empty = use ambient ADC) ---
# GCP_CREDENTIALS_FILE: path to a service-account or user-cred JSON.
# GCLOUD_CONFIG_NAME:   gcloud configuration to activate for `gcloud` subprocess
#                       calls (sets CLOUDSDK_ACTIVE_CONFIG_NAME).
GCP_CREDENTIALS_FILE=
GCLOUD_CONFIG_NAME=

# === Sane defaults (override in shared.env.local only if you really need to) ===

# --- GCP region / location ---
REGION=us-central1
BQ_LOCATION=US

# --- Artifact Registry ---
AR_REPOSITORY=pii-transform

# --- BigQuery ---
BQ_DATASET=pii_transform_demo
BQ_CONNECTION=pii_transform_conn
BQ_TABLE_CLEAR=pii_table_clear
BQ_TABLE_TOKENIZED=pii_table_tokenized

# --- FPE demo (no external vendor dependency) ---
# Own dataset so the sweep never touches the Protegrity demo's objects.
FPE_DATASET=fpe_perf_demo
FPE_TABLE_CLEAR=pii_clear
FPE_TABLE_TOKENIZED=pii_tokenized
# Source of clear-text rows for the demo tables. Either an existing table to
# copy from, or leave blank and load one with shared/generate_mock_data.py.
FPE_SOURCE_TABLE=pii_transform_demo.pii_table_1m
FPE_ROWS=1000000
FPE_SERVICE=pii-fpe-service
FPE_IMAGE_NAME=pii-fpe-service
# FPE_KEY: 32/48/64 hex chars (AES-128/192/256). Demo default — override in
# shared.env.local for anything you care about. Not a production secret.
FPE_KEY=EF4359D8D580AA4F7F036D6F04FC6A94
# FPE_TWEAK: 14 hex chars (56-bit) for FF3-1.
FPE_TWEAK=D8E7920AFA330A

# --- FPE service runtime defaults (the tuning knobs under study) ---
# Overridden per-revision by scripts/fpe/deploy.sh during a sweep.
FPE_CPU=1
FPE_MEMORY=1Gi
FPE_CONCURRENCY=8
FPE_MIN_INSTANCES=1
FPE_MAX_INSTANCES=1
FPE_WORKERS=2
FPE_THREADS=1
FPE_WORKER_CLASS=sync
FPE_CPU_BOOST=false
# "false" keeps CPU allocated outside request handling (needed for honest
# steady-state numbers); "true" is the cheaper request-scoped default.
FPE_CPU_THROTTLING=false
FPE_EXECUTION_ENV=gen2
FPE_REQUEST_TIMEOUT=900
FPE_LOG_REQUESTS=true

# --- Protegrity demo (legacy; requires vendor API access) ---
PROTEGRITY_SERVICE=pii-transform-service-protegrity

# --- Benchmark defaults ---
BENCH_ROWS=1000000
BENCH_ITERATIONS=3
